{
  "manifest_version": 3,
  "name": "BrandSentinel: check as you write",
  "short_name": "BrandSentinel",
  "version": "1.0.0",
  "description": "Checks the post you are writing against your brand's rules and approved facts, on any website, before it goes live.",
  "action": { "default_title": "BrandSentinel", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"]
}
